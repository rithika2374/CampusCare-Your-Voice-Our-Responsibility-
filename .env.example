# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: MongoDB Database Connection
# If provided, the server can sync with a MongoDB cluster (e.g. MongoDB Atlas)
# If omitted, CampusCare runs with the built-in persistent local JSON database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campuscare?retryWrites=true&w=majority

# Authentication Secret
AUTH_SECRET=campuscare_super_secret_jwt_key_2025

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
